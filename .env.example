# Local: copy to .env (never commit it).  Vercel: add the same names under Project → Settings → Environment Variables.

# --- Database (Turso) — REQUIRED on Vercel ---
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# --- Sessions — REQUIRED on Vercel. Any long random string (e.g. `openssl rand -hex 32`) ---
SESSION_SECRET=

# --- "Continue with Google" sign-in (Google Cloud → APIs & Services → Credentials → OAuth client ID, type Web) ---
# Authorized redirect URI to register:  https://<your-site>.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Emails via Gmail API (optional) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Public URL used for links inside emails (falls back to the Vercel production URL)
APP_URL=https://<your-site>.vercel.app
# Booking reminder goes out this many hours before the game starts
EMAIL_REMINDER_HOURS_BEFORE=2
# Optional
# APP_TIMEZONE=Asia/Kolkata
# CRON_SECRET=
