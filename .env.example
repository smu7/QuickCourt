# Vercel / Turso database (required for deployment)
# Create an empty Turso database and add these in Vercel -> Settings -> Environment Variables.
TURSO_DATABASE_URL=libsql://YOUR-DATABASE-YOUR-ORG.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN

# Random long secret used to sign login sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Gmail API — fill these in once the Google Cloud OAuth client + refresh token exist.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback   # only used when generating the refresh token
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Public base URL used for links inside emails
APP_URL=http://localhost:3000
# Booking reminder goes out this many hours before the game starts
EMAIL_REMINDER_HOURS_BEFORE=2
