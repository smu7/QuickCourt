# Copy to .env (never commit .env). Server-side only — these must never reach the browser.
# Gmail API — PENDING: fill these in once the Google Cloud OAuth client + refresh token exist.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback   # only used when generating the refresh token
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Public base URL used for links inside emails
APP_URL=http://localhost:3000
# Booking reminder goes out this many hours before the game starts
EMAIL_REMINDER_HOURS_BEFORE=2
