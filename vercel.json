{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": [
        "database.sqlite",
        "email/**",
        "assets/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}